<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Current packages -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.26" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />

    <!-- DEPENDABOT DEMO: Intentionally outdated packages with known CVEs -->
    <!-- CVE-2019-0820, CVE-2021-26701 — vulnerable regex in old  Newtonsoft -->
    <PackageReference Include="Newtonsoft.Json" Version="10.0.1" /><!-- CVE-2019-0820: vulnerable below 13.0.1 -->
    <!-- CVE-2017-0249 — older System.Net.Http -->
    <PackageReference Include="System.Net.Http" Version="4.3.0" />
    <!-- CVE-2021-26701 — HIGH: System.Text.Encodings.Web remote code execution -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.7.2" />
    <!-- CVE-2021-43877 — older ASPNET Core auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="3.1.0" />
    <!-- CVE-2022-34716 — older XML package -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="4.7.0" />
    <!-- CVE-2023-36414 — HIGH: Azure.Identity elevation of privilege -->
    <PackageReference Include="Azure.Identity" Version="1.6.0" />
    <!-- CVE-2022-41064 — HIGH: Microsoft.Data.SqlClient information disclosure -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="1.0.19128.1" />
  </ItemGroup>

</Project>
